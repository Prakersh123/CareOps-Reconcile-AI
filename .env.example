# Zetaris (local Docker install). Same account you use for the web UI.
ZETARIS_BASE_URL=http://localhost:3000
ZETARIS_USERNAME=admin@zetaris.com
ZETARIS_PASSWORD=

# LLM via Meterless (OpenAI-compatible endpoint) - filled in at Step 3
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# LangSmith tracing
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=careops-reconcile
