# CareOps Reconcile AI — copy to .env and fill in. Placeholders only; never commit real values.

# --- Zetaris (data layer) -----------------------------------------------------------------
# Option A, as in the hackathon setup guide: the REST API with an API key you create in the
# Zetaris web interface (user menu). Org id is 1 on a local install.
ZETARIS_REST_URL=http://localhost:8888/api/v1.0
ZETARIS_ORG_ID=1
ZETARIS_API_KEY=your-zetaris-api-key
# Option B, used when ZETARIS_API_KEY is empty: sign in through the web interface.
ZETARIS_BASE_URL=http://localhost:3000
ZETARIS_USERNAME=admin@zetaris.com
ZETARIS_PASSWORD=your-zetaris-password
# (docker-compose.yml points both at host.docker.internal inside the container.)

# Password of the synthetic billing database that scripts/setup_zetaris.py starts
# (reachable only on the Zetaris Docker network).
BILLING_DB_PASSWORD=careops-synthetic-data

# --- Meterless Nightshift (primary AI provider) -------------------------------------------
# From Nightshift's Console. When set and the runtime is online, every agent uses it.
# Inside Docker use http://host.docker.internal:8088/v1.
METERLESS_BASE_URL=http://127.0.0.1:8088/v1
METERLESS_RUNTIME_TOKEN=your-nightshift-runtime-token
METERLESS_MODEL=meterless/auto

# --- Direct provider (fallback) -----------------------------------------------------------
# Used when Nightshift is not configured or not reachable (e.g. no Nightshift build for your OS).
# With Nightshift, put the NVIDIA key in Nightshift's Providers tab instead of here.
NVIDIA_API_KEY=
# Force a model for all agents, overriding the order above. Leave empty for automatic.
#   nvidia:nvidia/nemotron-3.5-lightning-30b-a3b  |  meterless/auto
CAREOPS_MODEL=

# --- Runtime behaviour --------------------------------------------------------------------
# true = no Zetaris, model or network: bundled sample rows, rule-based stand-ins, real World Model + code checks
SAMPLE_MODE=false
LOG_LEVEL=INFO
HOST=0.0.0.0
PORT=8000
# Whole-run budget in seconds; no new attempt starts after it (run ends INCONCLUSIVE)
RUN_TIMEOUT_SECONDS=600
# Where logs/, reports/ and .world/ are written (default: the project folder)
CAREOPS_HOME=

# --- LangSmith tracing (optional) ---------------------------------------------------------
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=careops-reconcile
