# Zetaris (local Docker install). Same account you use for the web UI.
ZETARIS_BASE_URL=http://localhost:3000
ZETARIS_USERNAME=admin@zetaris.com
ZETARIS_PASSWORD=

# Meterless Runtime (OpenAI-compatible). Fill with: python -m careops.meterless detect / connect / status
meterless_base_url=http://127.0.0.1:8088/v1
# Token from <stateDir>/proxy-token. "rt-local" is a placeholder and is rejected.
meterless_runtime_token=
# Optional: if set and no token above, <stateDir>/proxy-token is read directly.
meterless_state_dir=

# LangSmith tracing
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=careops-reconcile
GROQ_API_KEY=your-key-here

# NVIDIA hosted API (build.nvidia.com -> Get API Key)
NVIDIA_API_KEY=

# Model for all agents. Switch provider here:
#   nvidia:nvidia/nemotron-3.5-lightning-30b-a3b   (NVIDIA hosted Nemotron, default)
#   groq:openai/gpt-oss-20b                         (Groq)
#   meterless/auto                                  (Meterless Runtime)
CAREOPS_MODEL=nvidia:nvidia/nemotron-3.5-lightning-30b-a3b
